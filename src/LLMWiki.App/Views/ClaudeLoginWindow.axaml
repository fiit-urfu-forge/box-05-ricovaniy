<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LLMWiki.App.ViewModels"
        x:Class="LLMWiki.App.Views.ClaudeLoginWindow"
        x:DataType="vm:ClaudeLoginViewModel"
        x:CompileBindings="True"
        Title="Claude — авторизация"
        Width="900" Height="640">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Авторизация Claude Code" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Запустите `claude login`. Окно показывает вывод PTY и принимает ввод."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12" BorderBrush="#374151" BorderThickness="1"
                Background="#0F172A" CornerRadius="4">
            <ScrollViewer Padding="8">
                <SelectableTextBlock Text="{CompiledBinding Output}"
                                     Foreground="#E5E7EB"
                                     FontFamily="Cascadia Mono, Consolas, monospace" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4">
            <TextBox Grid.Column="0"
                     Text="{CompiledBinding Input, Mode=TwoWay}"
                     PlaceholderText="ввод (Enter)" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="Отправить"
                    Command="{CompiledBinding SendInputCommand}" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Запустить claude login"
                    Command="{CompiledBinding StartCommand}"
                    IsEnabled="{CompiledBinding IsNotRunning}" />
            <Button Content="Отменить"
                    Command="{CompiledBinding CancelCommand}"
                    IsEnabled="{CompiledBinding IsRunning}" />
            <Button Content="Проверить credentials"
                    Command="{CompiledBinding RecheckCommand}" />
            <TextBlock VerticalAlignment="Center"
                       Opacity="0.7"
                       Text="{CompiledBinding StatusMessage}" />
        </StackPanel>
    </Grid>
</Window>
