<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LLMWiki.App.ViewModels"
        x:Class="LLMWiki.App.Views.ConflictResolutionWindow"
        x:DataType="vm:ConflictResolutionViewModel"
        x:CompileBindings="True"
        Title="Разрешение конфликтов"
        Width="1100" Height="720">

    <Grid RowDefinitions="*,Auto" Margin="12">
        <ItemsControl Grid.Row="0" ItemsSource="{CompiledBinding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ConflictResolutionItem">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" Padding="8" Margin="0,0,0,12" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{CompiledBinding RelativePath}" FontWeight="Bold" />
                            <Grid ColumnDefinitions="*,*" Margin="0,8" RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Моя версия" FontStyle="Italic" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Версия из GitHub" FontStyle="Italic" />
                                <Border Grid.Row="1" Grid.Column="0" Margin="0,4,4,0"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <SelectableTextBlock Text="{CompiledBinding Entry.LocalContent}"
                                                             FontFamily="Cascadia Mono, Consolas, monospace" />
                                    </ScrollViewer>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <SelectableTextBlock Text="{CompiledBinding Entry.RemoteContent}"
                                                             FontFamily="Cascadia Mono, Consolas, monospace" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <RadioButton GroupName="{CompiledBinding RelativePath}"
                                             Content="Оставить мою"
                                             IsChecked="{CompiledBinding Choice, Mode=TwoWay, Converter={x:Static vm:ConflictChoiceToBoolConverter.KeepLocal}}" />
                                <RadioButton GroupName="{CompiledBinding RelativePath}"
                                             Content="Взять из GitHub"
                                             IsChecked="{CompiledBinding Choice, Mode=TwoWay, Converter={x:Static vm:ConflictChoiceToBoolConverter.TakeRemote}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="1"
                HorizontalAlignment="Right"
                Content="Применить все решения"
                IsEnabled="{CompiledBinding AllResolved}" />
    </Grid>
</Window>
